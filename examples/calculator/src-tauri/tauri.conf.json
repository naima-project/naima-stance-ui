{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Calculator",
  "version": "0.1.0",
  "identifier": "com.makebecome.calculator",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "deno task example:calculator:build",
    "beforeDevCommand": "deno task example:calculator"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Calculator",
        "width": 400,
        "height": 720,
        "minWidth": 320,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
