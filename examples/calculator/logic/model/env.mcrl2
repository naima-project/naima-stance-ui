% env.mcrl2 -- the calculator's environment (never generated): the user, who may press any
% key at any time (Core decides which it takes), and the registers, which carry out each
% output and answer every calculation with c_ok or c_fault, nondeterministically.

map I_limit: Inst -> Nat;          % the digits an operand may hold

act e_digit, digit: Nat;
    e_point, e_back, e_negate, e_equals, e_clear, e_ok, e_fault,
    point, back, negate, equals, clear, ok, fault;
    e_operator, operator: Op;
    e_enter, enter: Nat # Bool;
    e_dot, dot_: Bool;
    e_drop, e_flip, e_reset, drop, flip, reset;
    e_apply, apply: Op;

% waiting: a calculation was asked and not answered yet
proc Env(ins: Inst, waiting: Bool) =
    (!waiting) -> sum d: Nat . (d < 10) -> e_digit(d) . Env()
  + (!waiting) -> e_point . Env()
  + (!waiting) -> e_back . Env()
  + (!waiting) -> e_negate . Env()
  + (!waiting) -> sum o: Op . (o != NONE) -> e_operator(o) . Env()
  + (!waiting) -> e_equals . Env()
  + (!waiting) -> e_clear . Env()
  + sum d: Nat, f: Bool . e_enter(d, f) . Env()
  + sum f: Bool . e_dot(f) . Env()
  + e_drop . Env()
  + e_flip . Env()
  + e_reset . Env()
  + sum o: Op . e_apply(o) . Env(waiting = true)
  + waiting -> e_ok . Env(waiting = false)
  + waiting -> e_fault . Env(waiting = false);

% Core's initial state for a configuration (the generator appends the refined Core's
% extra parameters to this call).
proc CoreStart(limit: Nat) =
  Core(limit, FIRST, NONE, 0, 0, false, FIRST, IDLE);

act c_pick, e_pick, pick: Inst;
proc CoreSel = sum i: Inst . c_pick(i) . CoreStart(I_limit(i));
     EnvSel = sum i: Inst . e_pick(i) . Env(i, false);
     System =
  allow({ pick, digit, point, back, negate, operator, equals, clear, ok, fault,
          enter, dot_, drop, flip, apply, reset
%@obs-allow
        },
  comm({ c_pick | e_pick -> pick,
         c_digit | e_digit -> digit,
         c_point | e_point -> point,
         c_back | e_back -> back,
         c_negate | e_negate -> negate,
         c_operator | e_operator -> operator,
         c_equals | e_equals -> equals,
         c_clear | e_clear -> clear,
         c_ok | e_ok -> ok,
         c_fault | e_fault -> fault,
         c_enter | e_enter -> enter,
         c_dot | e_dot -> dot_,
         c_drop | e_drop -> drop,
         c_flip | e_flip -> flip,
         c_apply | e_apply -> apply,
         c_reset | e_reset -> reset },
    CoreSel || EnvSel));
