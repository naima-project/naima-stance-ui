% GENERATED by naima-codegen (docs/spec.md §3.9.7) from the Core named in its
% file name, the model's env.mcrl2 and instances/{small.mcrl2}. Do not edit.

sort Inst = struct i_small;

% GENERATED FILE: DO NOT EDIT.
% Generated by naima-codegen from the model's core.mcrl2, codegen.toml and
% policy.toml; see MANIFEST.json in the generated directory (docs/spec.md §3.1.3).
% Any edit here is lost at the next generation, and naima-codegen generate --check
% refuses the project while this file differs from what the model generates.
% To change it: change the model, verify its properties, run
% naima-codegen generate, and commit the model and the generated directory together.
% core.mcrl2 -- the calculator's control, as one linear process (naima-codegen, docs/spec.md §3.5).
%
% The model decides what each key does and when: which keys are allowed, when an
% operand starts and ends, when a calculation runs and what happens after it. The
% numbers themselves are data and live in the registers machine beside it (the two
% together are their parallel composition). The control tells the registers what to
% do through its outputs, and the registers' verdict on a calculation comes back as
% an input: c_ok, or c_fault for a division by zero or a number too large to show.
%
% Phases: FIRST (typing the first operand), AFTER_OP (an operator chosen, the second
% operand not started), SECOND (typing the second operand), CALC (waiting for the
% registers), DONE (a result shown), FAULT (an error shown).
%
% Every key is accepted in every phase but CALC: a key that cannot act now (a second
% point, equals with no second operand, an operator after an error) is taken and changes
% nothing, as on a pocket calculator. So the interface never needs to disable a key, and
% the model is receptive to everything the user can press (naima-codegen §3.9.7).

sort Op    = struct NONE | ADD | SUB | MUL | DIV;
sort Phase = struct FIRST | AFTER_OP | SECOND | CALC | DONE | FAULT;
sort Todo  = struct IDLE
                  | T_ENTER(td: Nat, tf: Bool)?is_enter
                  | T_DOT(tdf: Bool)?is_dot
                  | T_DROP?is_drop
                  | T_FLIP?is_flip
                  | T_APPLY(ta: Op)?is_apply
                  | T_RESET?is_reset;

act  c_digit: Nat;
     c_point, c_back, c_negate, c_equals, c_clear, c_ok, c_fault;
     c_operator: Op;
     c_enter: Nat # Bool;
     c_dot: Bool;
     c_drop, c_flip, c_reset;
     c_apply: Op;

% ---- the policy's maps and the reference definitions of the selection operations
% (docs/spec.md §3.7.1, §3.7.4)

% ---- the enabledness of the refined outputs (docs/spec.md §3.7.2)
map ix_en_0: Todo -> Bool;
var ix_p_todo: Todo;
eqn ix_en_0(ix_p_todo) = is_enter(ix_p_todo);
map ix_en_1: Todo -> Bool;
var ix_p_todo: Todo;
eqn ix_en_1(ix_p_todo) = is_dot(ix_p_todo);
map ix_en_2: Todo -> Bool;
var ix_p_todo: Todo;
eqn ix_en_2(ix_p_todo) = is_drop(ix_p_todo);
map ix_en_3: Todo -> Bool;
var ix_p_todo: Todo;
eqn ix_en_3(ix_p_todo) = is_flip(ix_p_todo);
map ix_en_4: Todo -> Bool;
var ix_p_todo: Todo;
eqn ix_en_4(ix_p_todo) = is_apply(ix_p_todo);
map ix_en_5: Todo -> Bool;
var ix_p_todo: Todo;
eqn ix_en_5(ix_p_todo) = is_reset(ix_p_todo);
map ix_quiet: Todo -> Bool;
var ix_p_todo: Todo;
eqn ix_quiet(ix_p_todo) = !ix_en_0(ix_p_todo) && !ix_en_1(ix_p_todo) && !ix_en_2(ix_p_todo) && !ix_en_3(ix_p_todo) && !ix_en_4(ix_p_todo) && !ix_en_5(ix_p_todo);

act o_digits, o_pending, o_waiting;

proc Core(
  limit: Nat,
  phase: Phase,
  op: Op,
  whole: Nat,
  frac: Nat,
  dot: Bool,
  then: Phase,
  todo: Todo
) =
   % c_digit input
sum d: Nat .
    (((d < 10 && todo == IDLE && (phase == FIRST || phase == SECOND) && whole + frac < limit)) && ix_quiet(todo)) ->
    c_digit(d) .
    Core(whole = if(dot, whole, whole + 1),
         frac = if(dot, frac + 1, frac),
         todo = T_ENTER(d, false))

 + % c_digit#2 input
sum d: Nat .
    (((d < 10 && todo == IDLE && phase == AFTER_OP)) && ix_quiet(todo)) ->
    c_digit(d) .
    Core(phase = SECOND,
         whole = 1,
         frac = 0,
         dot = false,
         todo = T_ENTER(d, true))

 + % c_digit#3 input
sum d: Nat .
    (((d < 10 && todo == IDLE && (phase == DONE || phase == FAULT))) && ix_quiet(todo)) ->
    c_digit(d) .
    Core(phase = FIRST,
         op = NONE,
         whole = 1,
         frac = 0,
         dot = false,
         todo = T_ENTER(d, true))

 + % c_point input
(((todo == IDLE && (phase == FIRST || phase == SECOND) && !dot && whole + frac < limit)) && ix_quiet(todo)) ->
    c_point .
    Core(dot = true,
         todo = T_DOT(false))

 + % c_point#2 input
(((todo == IDLE && phase == AFTER_OP)) && ix_quiet(todo)) ->
    c_point .
    Core(phase = SECOND,
         whole = 0,
         frac = 0,
         dot = true,
         todo = T_DOT(true))

 + % c_point#3 input
(((todo == IDLE && (phase == DONE || phase == FAULT))) && ix_quiet(todo)) ->
    c_point .
    Core(phase = FIRST,
         op = NONE,
         whole = 0,
         frac = 0,
         dot = true,
         todo = T_DOT(true))

 + % c_back input
(((todo == IDLE && (phase == FIRST || phase == SECOND) && (whole + frac > 0 || dot))) && ix_quiet(todo)) ->
    c_back .
    Core(frac = if(frac > 0, Int2Nat(frac - 1), frac),
         dot = if(frac > 0, dot, false),
         whole = if(frac == 0 && !dot, Int2Nat(whole - 1), whole),
         todo = T_DROP)

 + % c_negate input
(((todo == IDLE && (phase == FIRST || phase == SECOND || phase == DONE))) && ix_quiet(todo)) ->
    c_negate .
    Core(todo = T_FLIP)

 + % c_operator input
sum o: Op .
    (((o != NONE && todo == IDLE && (phase == FIRST || phase == SECOND))) && ix_quiet(todo)) ->
    c_operator(o) .
    Core(phase = CALC,
         then = AFTER_OP,
         op = o,
         todo = T_APPLY(op))

 + % c_operator#2 input
sum o: Op .
    (((o != NONE && todo == IDLE && (phase == AFTER_OP || phase == DONE))) && ix_quiet(todo)) ->
    c_operator(o) .
    Core(phase = AFTER_OP,
         op = o)

 + % c_equals input
(((todo == IDLE && phase == SECOND)) && ix_quiet(todo)) ->
    c_equals .
    Core(phase = CALC,
         then = DONE,
         op = NONE,
         todo = T_APPLY(op))

 + % c_digit#4 input
sum d: Nat .
    (((d < 10 && todo == IDLE && (phase == FIRST || phase == SECOND) && whole + frac >= limit)) && ix_quiet(todo)) ->
    c_digit(d) .
    Core()

 + % c_point#4 input
(((todo == IDLE && (phase == FIRST || phase == SECOND) && (dot || whole + frac >= limit))) && ix_quiet(todo)) ->
    c_point .
    Core()

 + % c_back#2 input
(((todo == IDLE && (phase == AFTER_OP || phase == DONE || phase == FAULT
                      || ((phase == FIRST || phase == SECOND) && whole + frac == 0 && !dot)))) && ix_quiet(todo)) ->
    c_back .
    Core()

 + % c_negate#2 input
(((todo == IDLE && (phase == AFTER_OP || phase == FAULT))) && ix_quiet(todo)) ->
    c_negate .
    Core()

 + % c_operator#3 input
sum o: Op .
    (((o != NONE && todo == IDLE && phase == FAULT)) && ix_quiet(todo)) ->
    c_operator(o) .
    Core()

 + % c_equals#2 input
(((todo == IDLE && phase != CALC && phase != SECOND)) && ix_quiet(todo)) ->
    c_equals .
    Core()

 + % c_clear input
(((todo == IDLE && phase != CALC)) && ix_quiet(todo)) ->
    c_clear .
    Core(phase = FIRST,
         op = NONE,
         whole = 0,
         frac = 0,
         dot = false,
         todo = T_RESET)

 + % c_ok input
(((todo == IDLE && phase == CALC)) && ix_quiet(todo)) ->
    c_ok .
    Core(phase = then,
         whole = 0,
         frac = 0,
         dot = false)

 + % c_fault input
(((todo == IDLE && phase == CALC)) && ix_quiet(todo)) ->
    c_fault .
    Core(phase = FAULT,
         op = NONE,
         whole = 0,
         frac = 0,
         dot = false)

 + % c_enter output c_enter
(ix_en_0(todo)) ->
    c_enter(td(todo), tf(todo)) .
    Core(todo = IDLE)

 + % c_dot output c_dot
(ix_en_1(todo) && !ix_en_0(todo)) ->
    c_dot(tdf(todo)) .
    Core(todo = IDLE)

 + % c_drop output c_drop
(ix_en_2(todo) && !ix_en_0(todo) && !ix_en_1(todo)) ->
    c_drop .
    Core(todo = IDLE)

 + % c_flip output c_flip
(ix_en_3(todo) && !ix_en_0(todo) && !ix_en_1(todo) && !ix_en_2(todo)) ->
    c_flip .
    Core(todo = IDLE)

 + % c_apply output c_apply
(ix_en_4(todo) && !ix_en_0(todo) && !ix_en_1(todo) && !ix_en_2(todo) && !ix_en_3(todo)) ->
    c_apply(ta(todo)) .
    Core(todo = IDLE)

 + % c_reset output c_reset
(ix_en_5(todo) && !ix_en_0(todo) && !ix_en_1(todo) && !ix_en_2(todo) && !ix_en_3(todo) && !ix_en_4(todo)) ->
    c_reset .
    Core(todo = IDLE)


  % an operand never holds more digits than the limit
  + (whole + frac > limit) -> o_digits . Core()
  % at the end of a step the registers have been told everything
  + (ix_quiet(todo) && todo != IDLE) -> o_pending . Core()
  % a calculation is awaited only in the CALC phase, and then always for a known phase
  + (phase == CALC && (then != AFTER_OP && then != DONE)) -> o_waiting . Core()
  + delta;

% env.mcrl2 -- the calculator's environment (never generated): the user, who may press any
% key at any time (Core decides which it takes), and the registers, which carry out each
% output and answer every calculation with c_ok or c_fault, nondeterministically.

map I_limit: Inst -> Nat;          % the digits an operand may hold

act e_digit, digit: Nat;
    e_point, e_back, e_negate, e_equals, e_clear, e_ok, e_fault,
    point, back, negate, equals, clear, ok, fault;
    e_operator, operator: Op;
    e_enter, enter: Nat # Bool;
    e_dot, dot_: Bool;
    e_drop, e_flip, e_reset, drop, flip, reset;
    e_apply, apply: Op;

% waiting: a calculation was asked and not answered yet
proc Env(ins: Inst, waiting: Bool) =
    (!waiting) -> sum d: Nat . (d < 10) -> e_digit(d) . Env()
  + (!waiting) -> e_point . Env()
  + (!waiting) -> e_back . Env()
  + (!waiting) -> e_negate . Env()
  + (!waiting) -> sum o: Op . (o != NONE) -> e_operator(o) . Env()
  + (!waiting) -> e_equals . Env()
  + (!waiting) -> e_clear . Env()
  + sum d: Nat, f: Bool . e_enter(d, f) . Env()
  + sum f: Bool . e_dot(f) . Env()
  + e_drop . Env()
  + e_flip . Env()
  + e_reset . Env()
  + sum o: Op . e_apply(o) . Env(waiting = true)
  + waiting -> e_ok . Env(waiting = false)
  + waiting -> e_fault . Env(waiting = false);

% Core's initial state for a configuration (the generator appends the refined Core's
% extra parameters to this call).
proc CoreStart(limit: Nat) =
  Core(limit, FIRST, NONE, 0, 0, false, FIRST, IDLE);

act c_pick, e_pick, pick: Inst;
proc CoreSel = sum i: Inst . c_pick(i) . CoreStart(I_limit(i));
     EnvSel = sum i: Inst . e_pick(i) . Env(i, false);
     System =
  allow({ pick, digit, point, back, negate, operator, equals, clear, ok, fault,
          enter, dot_, drop, flip, apply, reset
, o_digits, o_pending, o_waiting
        },
  comm({ c_pick | e_pick -> pick,
         c_digit | e_digit -> digit,
         c_point | e_point -> point,
         c_back | e_back -> back,
         c_negate | e_negate -> negate,
         c_operator | e_operator -> operator,
         c_equals | e_equals -> equals,
         c_clear | e_clear -> clear,
         c_ok | e_ok -> ok,
         c_fault | e_fault -> fault,
         c_enter | e_enter -> enter,
         c_dot | e_dot -> dot_,
         c_drop | e_drop -> drop,
         c_flip | e_flip -> flip,
         c_apply | e_apply -> apply,
         c_reset | e_reset -> reset },
    CoreSel || EnvSel));

% small: operands of at most two digits.
eqn I_limit(i_small) = 2;

init System;
