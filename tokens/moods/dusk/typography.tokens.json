{
  "font": {
    "family": {
      "$type": "fontFamily",
      "body": {
        "$value": [
          "Iowan Old Style",
          "Palatino Linotype",
          "Georgia",
          "serif"
        ]
      },
      "mono": {
        "$value": [
          "ui-monospace",
          "Menlo",
          "monospace"
        ]
      }
    },
    "size": {
      "$type": "dimension",
      "sm": {
        "$value": {
          "value": 0.8125,
          "unit": "rem"
        }
      },
      "md": {
        "$value": {
          "value": 0.9375,
          "unit": "rem"
        }
      },
      "lg": {
        "$value": {
          "value": 1.125,
          "unit": "rem"
        }
      },
      "xl": {
        "$value": {
          "value": 1.5,
          "unit": "rem"
        }
      }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": {
        "$value": 400
      },
      "strong": {
        "$value": 600
      }
    },
    "line-height": {
      "$type": "number",
      "tight": {
        "$value": 1.2
      },
      "normal": {
        "$value": 1.5
      }
    }
  }
}
