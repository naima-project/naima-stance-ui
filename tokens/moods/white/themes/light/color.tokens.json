{
  "$description": "White and minimal, light: black text on white, grey rules, one dark accent, almost no shadow.",
  "color": {
    "$type": "color",
    "surface": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1.0,
          1.0,
          1.0
        ],
        "hex": "#ffffff"
      }
    },
    "surface-raised": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1.0,
          1.0,
          1.0
        ],
        "hex": "#ffffff"
      }
    },
    "surface-sunken": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.965,
          0.965,
          0.965
        ],
        "hex": "#f6f6f6"
      }
    },
    "text": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.102,
          0.102,
          0.102
        ],
        "hex": "#1a1a1a"
      }
    },
    "text-muted": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.388,
          0.388,
          0.388
        ],
        "hex": "#636363"
      }
    },
    "border": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.89,
          0.89,
          0.89
        ],
        "hex": "#e3e3e3"
      }
    },
    "border-strong": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.541,
          0.541,
          0.541
        ],
        "hex": "#8a8a8a"
      }
    },
    "accent": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.102,
          0.102,
          0.102
        ],
        "hex": "#1a1a1a"
      }
    },
    "accent-hover": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.227,
          0.227,
          0.227
        ],
        "hex": "#3a3a3a"
      }
    },
    "on-accent": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1.0,
          1.0,
          1.0
        ],
        "hex": "#ffffff"
      }
    },
    "focus": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.184,
          0.435,
          0.871
        ],
        "hex": "#2f6fde"
      }
    },
    "danger": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.769,
          0.118,
          0.165
        ],
        "hex": "#c41e2a"
      }
    },
    "success": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.102,
          0.498,
          0.216
        ],
        "hex": "#1a7f37"
      }
    },
    "overlay": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.0,
          0.0,
          0.0
        ],
        "alpha": 0.32,
        "hex": "#000000"
      }
    },
    "key": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1.0,
          1.0,
          1.0
        ],
        "hex": "#ffffff"
      }
    },
    "key-hover": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.965,
          0.965,
          0.965
        ],
        "hex": "#f6f6f6"
      }
    },
    "key-pressed": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.922,
          0.922,
          0.922
        ],
        "hex": "#ebebeb"
      }
    },
    "accent-soft": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.925,
          0.925,
          0.925
        ],
        "hex": "#ececec"
      }
    },
    "border-soft": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.541,
          0.541,
          0.541
        ],
        "alpha": 0.4,
        "hex": "#8a8a8a"
      },
      "$description": "a rule between controls drawn over any surface: the strong border, light"
    },
    "surface-soft": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.965,
          0.965,
          0.965
        ],
        "alpha": 0.6,
        "hex": "#f6f6f6"
      },
      "$description": "a control drawn over a drawing or a card: the sunken surface, see-through"
    },
    "accent-tint": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.102,
          0.102,
          0.102
        ],
        "alpha": 0.1,
        "hex": "#1a1a1a"
      },
      "$description": "the accent as a faint wash behind what is chosen or under the pointer"
    },
    "accent-line": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.102,
          0.102,
          0.102
        ],
        "alpha": 0.45,
        "hex": "#1a1a1a"
      },
      "$description": "the edge of what is chosen: the accent, half see-through"
    },
    "on-accent-soft": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1.0,
          1.0,
          1.0
        ],
        "alpha": 0.25,
        "hex": "#ffffff"
      },
      "$description": "a mark drawn on the accent: the colour on the accent, light"
    }
  }
}
