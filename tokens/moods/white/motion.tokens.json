{
  "motion": {
    "duration": {
      "$type": "duration",
      "fast": {
        "$value": {
          "value": 100,
          "unit": "ms"
        }
      },
      "normal": {
        "$value": {
          "value": 180,
          "unit": "ms"
        }
      },
      "instant": {
        "$value": {
          "value": 70,
          "unit": "ms"
        }
      }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": {
        "$value": [
          0.2,
          0,
          0,
          1
        ]
      }
    }
  }
}
